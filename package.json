{
  "name": "orha-library-foundation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "build:vercel": "npm run audit:vercel-config && npm run build",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc -b",
    "check:edge": "deno task --config supabase/functions/deno.json check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:edge": "deno task --config supabase/functions/deno.json test",
    "test:e2e": "npm run test:e2e:production",
    "test:e2e:public": "playwright test --project=public-*",
    "test:e2e:production": "tsx scripts/require-production-e2e-secrets.ts && playwright test --project=public-* && playwright test --project=auth-lifecycle-chromium --workers=1 && playwright test --project=authenticated-chromium --workers=1",
    "audit:production-debt": "tsx scripts/audit-production-debt.ts",
    "audit:host": "tsx scripts/host-capability-audit.ts",
    "audit:vercel-config": "tsx scripts/require-vercel-build-configuration.ts",
    "audit:launch-config": "tsx scripts/require-launch-configuration.ts",
    "audit:bundle": "tsx scripts/bundle-budget.ts",
    "smoke:edge:anonymous": "tsx scripts/edge-functions-smoke.ts",
    "smoke:edge:authenticated": "tsx scripts/edge-functions-authenticated-smoke.ts",
    "audit:secrets": "tsx scripts/secret-audit.ts",
    "audit:text-encoding": "tsx scripts/text-encoding-audit.ts",
    "check:catalog": "tsx scripts/check-library-catalog.ts"
  },
