# The E2E runner reads process environment variables; do not commit real values.
ORHA_E2E_BASE_URL=
ORHA_STAGING_SUPABASE_URL=
ORHA_STAGING_SUPABASE_PUBLISHABLE_KEY=
ORHA_E2E_SUPABASE_HOST=

# Node-only Admin credential from the same staging project, used for disposable
# Auth lifecycle users. Never prefix it with VITE_ or expose it to the browser.
ORHA_E2E_SERVICE_ROLE_KEY=
# Catch-all domain owned by the E2E environment and external SMTP approval.
ORHA_E2E_EMAIL_DOMAIN=
ORHA_E2E_SMTP_DELIVERY_VERIFIED=

# Existing Supabase accounts with completed onboarding.
ORHA_E2E_USER_A_EMAIL=
ORHA_E2E_USER_A_PASSWORD=
ORHA_E2E_USER_A_PROFILE_TEXT=
# A distinct 12+ character value used only during the reversible password test.
ORHA_E2E_USER_A_ROTATED_PASSWORD=

ORHA_E2E_USER_B_EMAIL=
ORHA_E2E_USER_B_PASSWORD=
ORHA_E2E_USER_B_PROFILE_TEXT=

# Privileged principal used by the real moderation journey.
ORHA_E2E_ADMIN_EMAIL=
ORHA_E2E_ADMIN_PASSWORD=
ORHA_E2E_ADMIN_PROFILE_TEXT=
